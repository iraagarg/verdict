# ─────────────────────────────────────────────────────────────────────────────
# Verdict environment. Copy to .env and fill in.
#
# Every variable below is validated by a schema at process start
# (apps/gateway/src/env.ts, apps/evald/src/evald/settings.py). A missing or
# malformed value exits the process BEFORE the port is bound — it is never a
# request-time failure. See DESIGN.md failure mode #15.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# --- gateway ---
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# --- datastores ---
# Local docker compose defaults. Swap for Neon / Upstash URLs in deploy.
DATABASE_URL=postgres://verdict:verdict@localhost:5432/verdict
# OPTIONAL. Nothing connects to Redis: its only intended consumer was the
# semantic cache, which P6 measured and rejected (D-046, D-047, D-059).
# Validated when present, so a wrong value fails at boot rather than later.
REDIS_URL=redis://localhost:6379

# --- provider keys ---
# At least one must be present or the gateway refuses to start.
# Placeholder values below are intentionally invalid; replace them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- cost controls (DESIGN.md failure mode #12) ---
# Hard daily ceiling in USD. The gateway rejects requests once exceeded.
COST_CAP_USD_PER_DAY=5.00

# --- router (P5) ---
# "off" serves the strong safe_default for every auto-routed request. Switch to
# "offline" only with a fitted policy: the router must be turned on deliberately.
ROUTER_MODE=off
# POLICY_PATH=artifacts/policy.json

# --- evald ---
EVALD_PORT=8000
EVALD_HOST=0.0.0.0
