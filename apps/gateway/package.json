    "fastify": "^5.2.0",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
